##### Imports

FONT_FACE="JetBrainsMono Nerd Font"
SCRIPTS_DIR="$CONFIG_DIR/scripts"
. "$CONFIG_DIR/config.sh"

##### Defaults

sketchybar --default \
    icon.font="$FONT_FACE:Medium:15.0" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.font="$FONT_FACE:Medium:14.0" \
    label.color="$LABEL_COLOR" \
    label.y_offset=0 \
    label.padding_left=1 \
    label.padding_right=5

##### Modules

. "$CONFIG_DIR/modules/bar.sh"

# Left

. "$CONFIG_DIR/modules/aerospace.sh"

# Right

. "$CONFIG_DIR/modules/clock.sh"
. "$CONFIG_DIR/modules/volume.sh"
. "$CONFIG_DIR/modules/battery.sh"
. "$CONFIG_DIR/modules/system_stats.sh"
. "$CONFIG_DIR/modules/vpn.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
